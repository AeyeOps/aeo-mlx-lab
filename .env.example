# aeo-mlx-lab — local environment overrides
#
# Copy to `.env` (gitignored) and edit. Variables you leave unset fall back to
# the defaults shown here, which match the standard install path documented in
# README.md. Both bash (sourced via `set -a; . .env; set +a`) and Python
# (python-dotenv) read this file, so values may use ${VAR} interpolation but
# avoid quoting unless the value contains spaces.

# ---- paths the launchers / evaluator depend on -----------------------------

# Python venv created by `uv sync`. The shim and mlx-prepare console scripts
# are installed here.
VENV_DIR=${HOME}/.venvs/mlx

# System-installed launcher symlinks (per the README setup steps).
MLX_SERVE_BIN=${HOME}/.local/bin/mlx-serve
GHOSTTY_RUN_BIN=${HOME}/.local/bin/ghostty-run

# `claude` CLI binary used by the e2e evaluator's semantic-judge call.
CLAUDE_BIN=${HOME}/.local/bin/claude

# File with up to 3 lines of `CLAUDE_CODE_OAUTH_TOKEN=...` for the judge to
# rotate through. Keep this file 0600 and out of any shared backup tree.
KEYS_ENV=${HOME}/.config/secrets/keys.env

# ---- optional shim runtime overrides (defaults are usually fine) -----------

# MLX_SHIM_PORT=64080
# MLX_BACKEND_URL=http://127.0.0.1:64180
# MLX_SHIM_MAX_BODY_BYTES=52428800
# MLX_SHIM_STREAM_BUFFER_BYTES=16777216
# MLX_BACKEND_READY_TIMEOUT=600
